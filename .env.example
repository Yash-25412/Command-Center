# Copy to .env.local for local dev; set the same three in Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Comma-separated emails allowed to sign in. Leave set — empty means anyone with a link can sign in.
ALLOWED_EMAILS=you@example.com
